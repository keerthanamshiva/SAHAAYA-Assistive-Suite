GNANI_API_KEY=your_gnani_api_key_here

# Optional dedicated service-specific overrides
GNANI_STT_API_KEY=your_optional_stt_specific_key_here
GNANI_TTS_API_KEY=your_optional_tts_specific_key_here

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173
